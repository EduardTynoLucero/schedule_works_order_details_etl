TZ=America/Guatemala
CRON_EXPR=*/5 * * * *

# ========== DETALLE DE ORDENES ==========
ETL_RUN_ONCE=1
WORK_DETAILS_BATCH_SIZE=100
WORK_DETAILS_CONCURRENCY=4
WORK_DETAILS_LIMIT=0
WORK_DETAILS_START_AFTER_WORK_ID=0
WORK_DETAILS_ONLY_MISSING=1
# con ONLY_MISSING=1: tambien vuelve a pedir las ordenes cuyo estado/finish_date cambio en works
WORK_DETAILS_REFRESH_CHANGED=1
# minutos minimos entre dos consultas del detalle de la misma orden
WORK_DETAILS_REFRESH_MIN_AGE_MINUTES=15
# tambien refresca: terminadas en los ultimos N dias sin fecha de envio y creadas en los ultimos N dias sin fecha (0 = no)
WORK_DETAILS_REFRESH_MISSING_DATES_DAYS=7
# copia la fecha de envio del detalle a works.estimated_delivery
WORK_DETAILS_SYNC_WORKS_ESTIMATED_DELIVERY=1
WORK_DETAILS_BATCH_DELAY_MS=250

# Barrido diario: una sola vez al dia, desde la hora de inicio, actualiza el detalle de TODAS las ordenes
WORK_DETAILS_NIGHTLY_FULL=1
# hora de inicio (Guatemala, 0-23). No tiene hora de fin: corre hasta terminar
WORK_DETAILS_NIGHTLY_START_HOUR=17
# consultas simultaneas a la API durante el barrido (de dia se usa WORK_DETAILS_CONCURRENCY)
WORK_DETAILS_NIGHTLY_CONCURRENCY=8
